---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const news = (await getCollection('news', (n) => !n.data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<BaseLayout title="News & events">
  <h1>News & events</h1>

  {news.length === 0 && <p>No news yet.</p>}

  {news.map((n) => (
    <article>
      <h2>{n.data.title}</h2>
      <time datetime={n.data.publishDate.toISOString()}>
        {n.data.publishDate.toLocaleDateString('en-GB')}
      </time>
      <p>{n.data.summary}</p>
    </article>
  ))}
</BaseLayout>
